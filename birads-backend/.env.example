# ===== App =====
PROJECT_NAME="Explainable BI-RADS Diagnostic Engine"
ENVIRONMENT=development
DEBUG=true

# ===== Security / Auth =====
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with this placeholder when ENVIRONMENT=production.
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12
# Password policy + lockout after repeated failed sign-ins
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Database (PostgreSQL) =====
# `docker compose up -d db` starts PostgreSQL using POSTGRES_PASSWORD below;
# then create the schema with `alembic upgrade head`.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://birads:change-me@localhost:5432/birads

# ===== Storage =====
# Patient images are stored encrypted (AES-256-GCM) inside the database.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Back this key up separately — without it stored images cannot be decrypted.
DATA_ENCRYPTION_KEY=

# ===== ML =====
# true = load heavy models on first request (fast boot); false = load at startup
LAZY_MODEL_LOAD=true

# ===== Tier 6: Clinical RAG assistant =====
# OpenAI key for embeddings + gpt-4o-mini. Required to build the index and chat.
OPENAI_API_KEY=
# Optional overrides:
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_EMBED_MODEL=text-embedding-3-small
# RAG_TOP_K=4
