# ===== App =====
PROJECT_NAME="Explainable BI-RADS Diagnostic Engine"
ENVIRONMENT=development
DEBUG=true

# ===== Security / Google OAuth =====
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Google OAuth Web Client ID (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=207393739852-ptmr9042qa1n7on4dqjtqpa28gdoe3lt.apps.googleusercontent.com

# Comma-separated allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Database =====
# Dev (default): SQLite. Production example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/birads
DATABASE_URL=sqlite:///./birads.db

# ===== Storage =====
# local | cloudinary
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=birads

# ===== ML =====
# true = load heavy models on first request (fast boot); false = load at startup
LAZY_MODEL_LOAD=true

# ===== Tier 6: Clinical RAG assistant =====
# OpenAI key for embeddings + gpt-4o-mini. Required to build the index and chat.
OPENAI_API_KEY=
# Optional overrides:
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_EMBED_MODEL=text-embedding-3-small
# RAG_TOP_K=4
